    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2"
