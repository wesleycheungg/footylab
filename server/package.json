    "db:setup": "node --env-file=.env --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "~7.0.2"
  }
}
