{
  "name": "footylab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors green,cyan --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace server",
    "db:setup": "npm run db:setup --workspace server",
    "lint": "npm run lint --workspace client"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
